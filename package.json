{
  "name": "@particle-academy/fancy-fun-lab-ui",
  "version": "0.1.0",
  "description": "React UI for Laravel Fun Lab: profile summary, leaderboards per gamed metric, achievement grid, XP feed and level-up announcement. Controlled, JSON-friendly, accessible, agent-driveable.",
  "keywords": [
    "gamification",
    "leaderboard",
    "achievements",
    "xp",
    "react",
    "tailwind",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-fun-lab-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-fun-lab-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-fun-lab-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/react-fancy": ">=6.9.0 <7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@particle-academy/react-fancy": "^6.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
